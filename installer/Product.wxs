<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" 
           Name="Observer" 
           Language="1033" 
           Version="1.0.0.0" 
           Manufacturer="YourCompany" 
           UpgradeCode="12345678-1234-1234-1234-123456789012">
    
    <Package InstallerVersion="200" 
             Compressed="yes" 
             InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Feature Id="ProductFeature" Title="Observer" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="PythonComponents" />
    </Feature>

    <!-- Single TARGETDIR definition with all directories -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="Observer">
          <Directory Id="PYTHONDIR" Name="Python" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Observer"/>
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop"/>
    </Directory>

    <!-- Main application components only - PythonComponents will come from heat -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="ObserverExe" Guid="ABCDEF12-1234-1234-1234-123456789ABC">
        <File Id="ObserverExeFile" Source="dist\observer.exe" KeyPath="yes" />
        <Shortcut Id="StartMenuShortcut" 
                  Directory="ApplicationProgramsFolder"
                  Name="Observer"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ObserverIcon"
                  IconIndex="0"
                  Advertise="yes" />
      </Component>
      <Component Id="CleanupComponent" Guid="FEDCBA98-4321-4321-4321-CBA987654321">
        <RegistryValue Root="HKCU" 
                       Key="Software\YourCompany\Observer" 
                       Name="installed" 
                       Type="integer" 
                       Value="1" 
                       KeyPath="yes"/>
        <RemoveFolder Id="CleanupStartMenu" 
                      Directory="ApplicationProgramsFolder" 
                      On="uninstall"/>
      </Component>
    </ComponentGroup>

    <Icon Id="ObserverIcon" SourceFile="dist\observer.exe" />

  </Product>
</Wix>